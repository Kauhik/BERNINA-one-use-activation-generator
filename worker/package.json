{
  "name": "bernina-activation-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute bernina-activation --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute bernina-activation --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
